{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop Ultra",
  "version": "0.1.1",
  "identifier": "io.xyito.dsh-desktop-ultra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop Ultra",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../plugins/.pack/dsh-plugin-taskboard.tgz": "plugins/dsh-plugin-taskboard.tgz"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRDFDOTE5QTZFOTNFQ0IKUldUTFB1bW1HY25SYzFYdEVwbU1WYkZFQXNMZkRaWGxYR0pWMk1JazBtVzNvOE1ZeEROMzY2UXEK"
    }
  }
}
