{
  "name": "dsh-plugin-otools-dbm",
  "description": "Full database manager for the DeepSeek Harness web GUI — a faithful port of otools-dbm's 鲨鱼数据库 panel: connection tree, table data grid with inline editing, table designer, SQL workbench, Redis browser, export/import, backup center with schedules, structure+data sync, data dictionary, user manager, and an AI dashboard wired straight into DSH's own model. 复刻 otools-dbm 界面的 dsh 插件，Node 驱动，可发布到 dsh 插件市场。",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "src",
    "webview",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "author": "ijry (DSH Desktop Ultra contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra.git"
  },
  "bugs": {
    "url": "https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra/issues"
  },
  "homepage": "https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra/tree/main/plugins/dsh-plugin-otools-dbm#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "database",
    "otools-dbm",
    "mysql",
    "postgresql",
    "sqlite",
    "redis",
    "mongodb",
    "sql-client"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:webview": "vite build --config webview/vite.config.ts",
    "check": "node scripts/check.mjs",
    "typecheck": "vue-tsc --noEmit -p webview/tsconfig.json",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.9.0",
    "mysql2": "^3.11.3",
    "pg": "^8.13.0",
    "ssh2": "^1.16.0",
    "tedious": "^18.6.1"
  },
  "optionalDependencies": {
    "oracledb": "^6.6.0",
    "snowflake-sdk": "^1.15.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.12",
    "@element-plus/icons-vue": "^2.3.1",
    "@thesvg/vue": "^2.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueup/vue-quill": "^1.2.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.8.5",
    "quill": "^2.0.3",
    "sass": "^1.104.0",
    "typescript": "^5.7.2",
    "vditor": "^3.11.2",
    "vite": "^6.0.1",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}
