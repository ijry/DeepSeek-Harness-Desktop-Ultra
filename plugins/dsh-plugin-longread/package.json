{
  "name": "dsh-plugin-longread",
  "description": "Long-form reader for the DeepSeek Harness web GUI that renders a book as a fake agent session: a prompt, a few tool calls, a streamed reply. Imports .txt and .epub, ships with an original wuxia sample (九阴真经), and keeps the reading position per book. 把小说读成一场会话的 dsh 插件：远看像在 vibe coding，近看在看书。纯 GUI 插件，不注册工具、不改系统提示。",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "ijry (DSH Desktop Ultra contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra.git"
  },
  "bugs": {
    "url": "https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra/issues"
  },
  "homepage": "https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra/tree/main/plugins/dsh-plugin-longread#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "longread",
    "reader",
    "epub",
    "txt",
    "novel",
    "camouflage"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  }
}
