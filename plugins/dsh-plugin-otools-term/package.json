{
  "name": "dsh-plugin-otools-term",
  "description": "SSH / SFTP / remote-desktop workbench for the DeepSeek Harness web GUI, a faithful re-implementation of otools-term's 墨鱼终端 panel: xterm terminals over ssh2, a two-pane SFTP browser with recursive transfers, port forwarding and a SOCKS5 proxy, an RDP/VNC launcher, and DSH's own model behind the AI command bar. 复刻 otools-term 界面的 dsh 插件，可发布到 dsh 插件市场。",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": "ijry (DSH Desktop Ultra contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra.git"
  },
  "bugs": {
    "url": "https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra/issues"
  },
  "homepage": "https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra/tree/main/plugins/dsh-plugin-otools-term#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ssh",
    "sftp",
    "terminal",
    "xterm",
    "otools-term",
    "port-forwarding",
    "socks5"
  ],
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "5.5.0",
    "ssh2": "1.17.0",
    "ws": "8.21.3"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  }
}
