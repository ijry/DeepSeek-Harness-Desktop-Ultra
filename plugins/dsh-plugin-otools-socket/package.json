{
  "name": "dsh-plugin-otools-socket",
  "version": "0.1.0",
  "description": "Hidden shared control bus, paired device identity, and temporary transfer channels for DSH plugins.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": [], "platform": "web", "immediately": true },
    "compatibility": { "dshReleases": { "0.1.1-rc.2": "compatible", "0.1.5-rc.1": "compatible" } }
  },
  "files": ["lib", "src", "cordis.patch.yml", "LICENSE", "README.md"],
  "license": "MIT",
  "engines": { "node": ">=22" },
  "author": "ijry (DSH Desktop Ultra contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ijry/DeepSeek-Harness-Desktop-Ultra.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  }
}
